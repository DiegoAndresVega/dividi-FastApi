# Copia este archivo a .env y ajusta los valores.
# DATABASE_URL y SECRET_KEY son obligatorias: sin ellas la API no arranca.

DATABASE_URL=postgresql+psycopg2://gastos:gastos@localhost:5432/gastos

# Genera la tuya, no copies esta línea tal cual (la API rechaza el relleno):
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30
# Sesión larga: el refresh token se renueva en cada uso, así que con un año
# de margen quien use la app de vez en cuando nunca vuelve a ver el login.
REFRESH_TOKEN_EXPIRE_DAYS=365
