# Copia este archivo a .env y ajusta los valores
DATABASE_URL=postgresql+psycopg2://gastos:gastos@localhost:5432/gastos
SECRET_KEY=cambia-esto-por-una-clave-secreta-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Sesión larga: el refresh token se renueva en cada uso, así que con un año
# de margen quien use la app de vez en cuando nunca vuelve a ver el login.
REFRESH_TOKEN_EXPIRE_DAYS=365
