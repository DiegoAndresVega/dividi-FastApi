# Copia este archivo a .env y ajusta los valores.
# DATABASE_URL y SECRET_KEY son obligatorias: sin ellas la API no arranca.

# La API se conecta con un rol que solo puede leer y escribir filas: ni CREATE,
# ni ALTER, ni DROP. Ver docs/privilegios-bd.md.
DATABASE_URL=postgresql+psycopg2://gastos_app:gastos_app@localhost:5432/gastos

# El dueño de las tablas. Solo lo usan las migraciones, durante el despliegue.
MIGRATION_DATABASE_URL=postgresql+psycopg2://gastos:gastos@localhost:5432/gastos

# Genera la tuya, no copies esta línea tal cual (la API rechaza el relleno):
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# dev | prod. Por defecto prod: en prod se cierran /docs, /redoc y /openapi.json.
ENVIRONMENT=dev

ACCESS_TOKEN_EXPIRE_MINUTES=30
# Sesión larga: el refresh token se renueva en cada uso, así que con un año
# de margen quien use la app de vez en cuando nunca vuelve a ver el login.
REFRESH_TOKEN_EXPIRE_DAYS=365

# Emisor y audiencia que se firman en cada token y se exigen al verificarlo.
# Cámbialos si montas otro entorno con la misma clave: así un token de ese
# entorno no vale en este. Opcionales; estos son los valores por defecto.
JWT_ISSUER=dividi-api
JWT_AUDIENCE=dividi-app
